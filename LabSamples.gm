# ====================================================================
# ROOT GOAL & MAIN BRANCHES (Abstract Nodes)
# ====================================================================

Goal Achieve [SampleSafelyProcessed]
  InformalDef: The overall mission is to safely navigate, process, and transport lab samples without violating physical constraints.

Goal Maintain [SystemSafety]
  Refines: Goal Achieve [SampleSafelyProcessed]
  InformalDef: The robot must always adhere to safe navigation and operational protocols.

Goal Achieve [MissionLiveness]
  Refines: Goal Achieve [SampleSafelyProcessed]
  InformalDef: The robot must eventually complete its tasks, process the samples, and return to a ready state.

Assumption [EnvironmentPhysicsAndResponsiveness]
  Refines: Goal Achieve [SampleSafelyProcessed]
  InformalDef: The physical environment and sensors must obey the laws of physics and respond to robot commands.

# --------------------------------------------------------------------
# 0. INITIALIZATION
# --------------------------------------------------------------------

Initialization [EnvironmentStart]
  Refines: Assumption [EnvironmentPhysicsAndResponsiveness]
  InformalDef: The environment starts with the robot at the floor, without active requests, authorizations, or validated barcodes.
  FormalDef: !request & !auth_present & !human_pickup & at_floor & !at_lab & !barcode_ok

Initialization [SystemStart]
  Refines: Goal Maintain [SystemSafety]
  InformalDef: The robot controller starts completely idle.
  FormalDef: !goto_floor & !goto_lab & !scan & !load_machine & !log_event

# --------------------------------------------------------------------
# 1. GOAL MAINTAIN (System Safety Requirements)
# Restrições de transição do controlador (apenas controla outputs)
# --------------------------------------------------------------------

Goal Maintain [ExclusiveNavigation]
  Refines: Goal Maintain [SystemSafety]
  InformalDef: The robot cannot issue commands to navigate to the floor and the lab simultaneously.
  FormalDef: !(goto_floor & goto_lab)

Goal Maintain [ScanRequiresAuthorizedSampleAtFloor]
  Refines: Goal Maintain [SystemSafety]
  InformalDef: Scanning is only permitted if the robot is at the floor, an authorization is present, the barcode is not yet OK, and human pickup is not happening.
  FormalDef: scan -> (at_floor & auth_present & !barcode_ok & !human_pickup)

Goal Maintain [LabNavigationRequiresSample]
  Refines: Goal Maintain [SystemSafety]
  InformalDef: Navigation to the lab can only occur if the barcode is OK or the robot is already not at the floor.
  FormalDef: goto_lab -> (barcode_ok | !at_floor)

Goal Maintain [NavigationPersistence]
  Refines: Goal Maintain [SystemSafety]
  InformalDef: Once a valid request is being handled or the robot is in transit to the lab, the goto_lab command must persist until arrival.
  FormalDef: ((request & barcode_ok & at_floor & !human_pickup) | (goto_lab & !at_lab & !human_pickup)) -> goto_lab'

Goal Maintain [LoadRequiresLabSample]
  Refines: Goal Maintain [SystemSafety]
  InformalDef: The robot can only load the machine if it is at the lab and the barcode is OK.
  FormalDef: load_machine -> (at_lab & barcode_ok & !human_pickup)

Goal Maintain [LoadWhenReady]
  Refines: Goal Maintain [SystemSafety]
  InformalDef: If the robot is at the lab and the barcode is OK, it must initiate the loading process.
  FormalDef: (at_lab & barcode_ok & !human_pickup) -> load_machine

Goal Maintain [NoPrematureReturn]
  Refines: Goal Maintain [SystemSafety]
  InformalDef: The robot cannot return to the floor while it holds a valid sample at the lab.
  FormalDef: (at_lab & barcode_ok & !human_pickup) -> !goto_floor

Goal Maintain [ReturnAfterProcessing]
  Refines: Goal Maintain [SystemSafety]
  InformalDef: Once at the lab and the sample is consumed (or picked up), the robot must initiate return to the floor in the next step.
  FormalDef: (at_lab & (!barcode_ok | human_pickup)) -> goto_floor'

Goal Maintain [ReturnPersistence]
  Refines: Goal Maintain [SystemSafety]
  InformalDef: The return command must persist until the robot arrives at the floor.
  FormalDef: (goto_floor & !at_floor) -> goto_floor'

Goal Maintain [IdleNavigation]
  Refines: Goal Maintain [SystemSafety]
  InformalDef: If idle at the floor without a request, do not initiate navigation to the lab.
  FormalDef: (!request & at_floor & !goto_lab & !goto_floor) -> !goto_lab'

Goal Maintain [IdleReturn]
  Refines: Goal Maintain [SystemSafety]
  InformalDef: If idle at the floor without a request, do not initiate navigation to the floor.
  FormalDef: (!request & at_floor & !goto_lab & !goto_floor) -> !goto_floor'

Goal Maintain [ActionsAreLogged]
  Refines: Goal Maintain [SystemSafety]
  InformalDef: Any proactive action (scan, navigation, loading) must trigger the logging event.
  FormalDef: (scan | goto_floor | goto_lab | load_machine) -> log_event

# --------------------------------------------------------------------
# 2. GOAL ACHIEVE (System Liveness Guarantees)
# O que o sistema promete alcançar ciclicamente
# --------------------------------------------------------------------

Goal Achieve [MissionCompletion]
  Refines: Goal Achieve [MissionLiveness]
  InformalDef: The system guarantees that if there is a request and authorization, the sample will eventually be loaded or picked up by a human.
  FormalDef: F (!(request & auth_present) | (load_machine | human_pickup))

Goal Achieve [ReturnToFloor]
  Refines: Goal Achieve [MissionLiveness]
  InformalDef: The robot guarantees it will always eventually return to the floor to be ready for new requests.
  FormalDef: F at_floor

# --------------------------------------------------------------------
# 3. ASSUMPTION (Environment Physics & Responsiveness)
# Regras do mundo real que o ambiente não pode quebrar
# --------------------------------------------------------------------

Assumption [LocationMutex]
  Refines: Assumption [EnvironmentPhysicsAndResponsiveness]
  InformalDef: The environment cannot physically place the robot at the floor and the lab simultaneously.
  FormalDef: !(at_floor & at_lab)

Assumption [FloorInertia]
  Refines: Assumption [EnvironmentPhysicsAndResponsiveness]
  InformalDef: If the robot is at the floor and not commanded to the lab, it remains at the floor.
  FormalDef: (at_floor & !goto_lab) -> at_floor'

Assumption [LaboratoryInertia]
  Refines: Assumption [EnvironmentPhysicsAndResponsiveness]
  InformalDef: If the robot is at the lab and not commanded to the floor, it remains at the lab.
  FormalDef: (at_lab & !goto_floor) -> at_lab'

Assumption [BarcodeReaderCausality]
  Refines: Assumption [EnvironmentPhysicsAndResponsiveness]
  InformalDef: The barcode status cannot become OK unless a scan occurs.
  FormalDef: (!barcode_ok & !scan) -> !barcode_ok'

Assumption [BarcodePersistence]
  Refines: Assumption [EnvironmentPhysicsAndResponsiveness]
  InformalDef: Once a barcode is OK, it remains OK until the machine is loaded or a human picks it up.
  FormalDef: (barcode_ok & !load_machine & !human_pickup) -> barcode_ok'

Assumption [SampleConsumed]
  Refines: Assumption [EnvironmentPhysicsAndResponsiveness]
  InformalDef: Loading the machine or human pickup consumes the sample, invalidating the barcode status for the next cycle.
  FormalDef: (load_machine | human_pickup) -> !barcode_ok'

Assumption [LaboratoryArrival]
  Refines: Assumption [EnvironmentPhysicsAndResponsiveness]
  InformalDef: The environment guarantees that commanding the robot to the lab will eventually result in arrival.
  FormalDef: goto_lab -> F at_lab

Assumption [FloorArrival]
  Refines: Assumption [EnvironmentPhysicsAndResponsiveness]
  InformalDef: The environment guarantees that commanding the robot to the floor will eventually result in arrival.
  FormalDef: goto_floor -> F at_floor

Assumption [BarcodeBecomesValid]
  Refines: Assumption [EnvironmentPhysicsAndResponsiveness]
  InformalDef: The environment guarantees that if authorization is present and a scan is executed, the barcode will eventually become valid.
  FormalDef: (auth_present & scan) -> F barcode_ok
