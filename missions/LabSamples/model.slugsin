[INPUT]
at_floor
at_lab
auth_present
barcode_ok
human_pickup
pending_monitor_BarcodeBecomesValid
pending_monitor_FloorArrival
pending_monitor_LaboratoryArrival
pending_monitor_MissionCompletion
pending_monitor_ReturnToFloor
request


[OUTPUT]
goto_floor
goto_lab
load_machine
log_event
scan


[ENV_TRANS]
| ! pending_monitor_MissionCompletion' & | pending_monitor_MissionCompletion & & & request auth_present ! human_pickup ! | human_pickup load_machine ! | human_pickup load_machine
| ! & | pending_monitor_MissionCompletion & & & request auth_present ! human_pickup ! | human_pickup load_machine ! | human_pickup load_machine pending_monitor_MissionCompletion'
| ! pending_monitor_ReturnToFloor' & | pending_monitor_ReturnToFloor & & at_lab | ! barcode_ok human_pickup ! goto_floor ! goto_floor
| ! & | pending_monitor_ReturnToFloor & & at_lab | ! barcode_ok human_pickup ! goto_floor ! goto_floor pending_monitor_ReturnToFloor'
! & at_floor at_lab
| ! & at_floor ! goto_lab at_floor'
| ! & at_lab ! goto_floor at_lab'
| ! & ! barcode_ok ! scan ! barcode_ok'
| ! & & barcode_ok ! load_machine ! human_pickup barcode_ok'
| ! | load_machine human_pickup ! barcode_ok'
| ! pending_monitor_LaboratoryArrival' & | pending_monitor_LaboratoryArrival & goto_lab ! at_lab ! at_lab
| ! & | pending_monitor_LaboratoryArrival & goto_lab ! at_lab ! at_lab pending_monitor_LaboratoryArrival'
| ! pending_monitor_FloorArrival' & | pending_monitor_FloorArrival & goto_floor ! at_floor ! at_floor
| ! & | pending_monitor_FloorArrival & goto_floor ! at_floor ! at_floor pending_monitor_FloorArrival'
| ! pending_monitor_BarcodeBecomesValid' & | pending_monitor_BarcodeBecomesValid & & auth_present scan ! barcode_ok ! barcode_ok
| ! & | pending_monitor_BarcodeBecomesValid & & auth_present scan ! barcode_ok ! barcode_ok pending_monitor_BarcodeBecomesValid'
| ! & & request ! load_machine ! human_pickup request'
| ! & & auth_present ! barcode_ok ! human_pickup auth_present'


[ENV_INIT]
! request
! auth_present
! human_pickup
at_floor
! at_lab
! barcode_ok
! pending_monitor_MissionCompletion
! pending_monitor_ReturnToFloor
! pending_monitor_LaboratoryArrival
! pending_monitor_FloorArrival
! pending_monitor_BarcodeBecomesValid


[SYS_TRANS]
! & goto_floor goto_lab
| ! scan & & & at_floor auth_present ! barcode_ok ! human_pickup
| ! goto_lab | barcode_ok ! at_floor
| ! | & & & request barcode_ok at_floor ! human_pickup & & goto_lab ! at_lab ! human_pickup goto_lab'
| ! load_machine & & at_lab barcode_ok ! human_pickup
| ! & & at_lab barcode_ok ! human_pickup load_machine
| ! & & at_lab barcode_ok ! human_pickup ! goto_floor
| ! & at_lab | ! barcode_ok human_pickup goto_floor'
| ! & goto_floor ! at_floor goto_floor'
| ! & & & & ! request ! barcode_ok at_floor ! goto_lab ! goto_floor ! goto_lab'
| ! & & & ! request at_floor ! goto_lab ! goto_floor ! goto_floor'
| ! | | | scan goto_floor goto_lab load_machine log_event


[SYS_INIT]
! goto_floor
! goto_lab
! scan
! load_machine
! log_event


[ENV_LIVENESS]
! pending_monitor_LaboratoryArrival
! pending_monitor_FloorArrival
! pending_monitor_BarcodeBecomesValid


[SYS_LIVENESS]
! pending_monitor_MissionCompletion
! pending_monitor_ReturnToFloor

