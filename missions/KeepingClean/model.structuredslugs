[INPUT]
at_base
at_room
pending_monitor_BaseArrival
pending_monitor_MissionCompletion
pending_monitor_ReturnToBase
pending_monitor_RoomArrival
request
room_cleaned
room_occupied

[OUTPUT]
abort_mission
clean_room
goto_base
goto_room

[ENV_INIT]
!request
at_base
!at_room
!room_occupied
!room_cleaned
!pending_monitor_MissionCompletion
!pending_monitor_ReturnToBase
!pending_monitor_RoomArrival
!pending_monitor_BaseArrival

[SYS_INIT]
!goto_base
!goto_room
!clean_room
!abort_mission

[ENV_TRANS]
(!pending_monitor_MissionCompletion' | ((pending_monitor_MissionCompletion | ((request) & !((clean_room | abort_mission)))) & !((clean_room | abort_mission))))
(!((pending_monitor_MissionCompletion | ((request) & !((clean_room | abort_mission)))) & !((clean_room | abort_mission))) | pending_monitor_MissionCompletion')
(!pending_monitor_ReturnToBase' | ((pending_monitor_ReturnToBase | (((!request & !at_base)) & !(goto_base))) & !(goto_base)))
(!((pending_monitor_ReturnToBase | (((!request & !at_base)) & !(goto_base))) & !(goto_base)) | pending_monitor_ReturnToBase')
!(at_base & at_room)
(at_base & !goto_room) -> at_base'
(at_room & !goto_base) -> at_room'
(clean_room) -> (room_cleaned')
((room_cleaned & request)) -> (room_cleaned')
(!request) -> (!room_cleaned')
((!room_cleaned & !clean_room & request)) -> (!room_cleaned')
(abort_mission) -> (!room_occupied')
((room_occupied & !abort_mission)) -> (room_occupied')
((clean_room | abort_mission)) -> (!request')
((request & !clean_room & !abort_mission)) -> (request')
(!pending_monitor_RoomArrival' | ((pending_monitor_RoomArrival | ((goto_room) & !(at_room))) & !(at_room)))
(!((pending_monitor_RoomArrival | ((goto_room) & !(at_room))) & !(at_room)) | pending_monitor_RoomArrival')
(!pending_monitor_BaseArrival' | ((pending_monitor_BaseArrival | ((goto_base) & !(at_base))) & !(at_base)))
(!((pending_monitor_BaseArrival | ((goto_base) & !(at_base))) & !(at_base)) | pending_monitor_BaseArrival')

[ENV_LIVENESS]
!pending_monitor_RoomArrival
!pending_monitor_BaseArrival

[SYS_TRANS]
!(goto_base' & goto_room')
(goto_room') -> ((request' & !room_cleaned'))
(goto_base') -> ((!request'))
((request' & goto_room & !at_room)) -> (goto_room')
(at_room) -> (!goto_room')
(((!request') & goto_base & !at_base)) -> (goto_base')
(clean_room') -> ((at_room' & request' & !room_occupied' & !room_cleaned'))
(abort_mission') -> ((at_room' & request' & room_occupied'))
((at_room' & request' & !room_occupied' & !room_cleaned')) -> (clean_room')
((at_room' & request' & room_occupied')) -> (abort_mission')
!(clean_room' & abort_mission')

[SYS_LIVENESS]
!pending_monitor_MissionCompletion
!pending_monitor_ReturnToBase
